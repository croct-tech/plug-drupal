{
    "name": "croct/plug-drupal",
    "description": "Drupal module to plug your Drupal site into Croct.",
    "license": "MIT",
    "type": "drupal-module",
    "keywords": [
        "croct",
        "personalization",
        "drupal",
        "module",
        "php"
    ],
    "authors": [
        {
            "name": "Croct",
            "email": "lib+plug-drupal@croct.com",
            "homepage": "https://croct.com"
        }
    ],
    "homepage": "https://github.com/croct-tech/plug-drupal",
    "support": {
        "issues": "https://github.com/croct-tech/plug-drupal/issues",
        "source": "https://github.com/croct-tech/plug-drupal"
    },
    "require": {
        "php": "^8.3",
        "croct/plug-php": "dev-initial-version as 1.0.0",
        "croct/plug-symfony": "dev-initial-implementation as 1.0.0"
    },
    "require-dev": {
        "croct/coding-standard": "^0.4.5",
        "drupal/core": "^11",
        "ergebnis/composer-normalize": "^2.28",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../plug-php"
        },
        {
            "type": "path",
            "url": "../symfony-bundle-php"
        }
    ],
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Drupal\\croct\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\croct\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": false,
            "drupal/core-project-message": false,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": [
            "composer validate",
            "composer normalize --dry-run",
            "mkdir -p .cache",
            "phpcs",
            "phpstan analyse --memory-limit=512M",
            "phpunit"
        ]
    }
}
